# Imagen reproducible para los tres nodos del clúster.
FROM postgres:16.15

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv \
    && python3 -m venv /opt/patroni \
    && /opt/patroni/bin/pip install --no-cache-dir "patroni[etcd3]==4.1.5" psycopg2-binary \
    && apt-get purge -y --auto-remove python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/patroni/bin:${PATH}"

COPY docker/patroni-entrypoint.sh /usr/local/bin/patroni-entrypoint.sh

RUN chmod 755 /usr/local/bin/patroni-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/patroni-entrypoint.sh"]
